{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // The type checker the linter runs does not support baseUrl; this
    // mapping reproduces it.
    "paths": { "*": ["./*"] },
    "outDir": "dist"
  },
  "include": [".botpress/**/*", "definitions/**/*", "src/**/*", "*.ts", "*.json"]
}
